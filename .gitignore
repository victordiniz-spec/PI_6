
# ==========================================
# PRODSYNC - GITIGNORE
# Mobile Expo + Web React + API NestJS
# ==========================================

# ------------------------------------------
# Dependencias Node.js
# ------------------------------------------
node_modules/
**/node_modules/

# ------------------------------------------
# Variaveis de ambiente e credenciais
# ------------------------------------------
.env
.env.*
**/.env
**/.env.*

# Permitir arquivos de exemplo sem senhas
!.env.example
!**/.env.example

# ------------------------------------------
# Expo / React Native
# ------------------------------------------
.expo/
**/.expo/

web-build/
expo-env.d.ts

# ------------------------------------------
# Builds gerados
# ------------------------------------------
dist/
**/dist/

build/
**/build/

coverage/
**/coverage/

.vite/
**/.vite/

# ------------------------------------------
# Arquivos nativos Android / iOS
# ------------------------------------------
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

/ios/
/android/

# ------------------------------------------
# Metro Bundler
# ------------------------------------------
.metro-health-check*

# ------------------------------------------
# Logs e arquivos temporarios
# ------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

tmp/
temp/
.cache/
**/.cache/

# ------------------------------------------
# Sistema operacional
# ------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------
# Certificados e chaves privadas
# ------------------------------------------
*.pem

# ------------------------------------------
# TypeScript
# ------------------------------------------
*.tsbuildinfo

# ------------------------------------------
# Prisma
# ------------------------------------------
# Ignorar o Prisma Client gerado
api/src/generated/
api/generated/

# IMPORTANTE:
# Nao ignorar:
# api/prisma/schema.prisma
# api/prisma/migrations/
# api/prisma.config.ts

# ------------------------------------------
# PostgreSQL / Docker
# ------------------------------------------
# Backups locais do banco
*.sql.gz
*.dump
*.backup

# Dados locais, caso sejam usados bind mounts
postgres_data/
pgdata/
db_data/

# IMPORTANTE:
# docker-compose.yml deve ser versionado
# para que toda a equipe utilize o mesmo ambiente.

# ------------------------------------------
# Arquivos de editores
# ------------------------------------------
.vscode/*
!.vscode/extensions.json

.idea/

# ------------------------------------------
# Outros arquivos locais
# ------------------------------------------
*.swp
*.swo
