
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// PERFIS DE USUÁRIOS
// ==========================================

enum PerfilUsuario {
  ADMIN
  SUPERVISOR
  OPERADOR
}

// ==========================================
// USUÁRIOS
// ==========================================

model Usuario {
  id        String        @id @default(uuid())
  nome      String
  email     String        @unique
  senhaHash String
  perfil    PerfilUsuario @default(OPERADOR)
  ativo     Boolean       @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  apontamentos      ApontamentoProducao[]
  paradasIniciadas  ParadaProducao[] @relation("ParadaIniciadaPor")
  paradasEncerradas ParadaProducao[] @relation("ParadaEncerradaPor")

  @@map("usuarios")
}

// ==========================================
// PRODUTOS
// ==========================================

model Produto {
  id          String  @id @default(uuid())
  codigo      String  @unique
  descricao   String
  cor         String?
  acabamento  String?
  larguraMm   Int?
  espessuraMm Int?
  unidade     String  @default("UN")
  ativo       Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  ordensProducao OrdemProducao[]

  @@map("produtos")
}

// ==========================================
// SITUAÇÕES DAS ORDENS DE PRODUÇÃO
// ==========================================

enum SituacaoOP {
  PENDENTE
  EM_PRODUCAO
  PAUSADA
  FINALIZADA
  CANCELADA
}

// ==========================================
// ORDENS DE PRODUÇÃO
// ==========================================

model OrdemProducao {
  id     String @id @default(uuid())
  numero String @unique

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  quantidadePlanejada Int
  quantidadeProduzida Int @default(0)

  situacao SituacaoOP @default(PENDENTE)

  observacoes  String?
  dataPrevisao DateTime?
  iniciadaEm   DateTime?
  finalizadaEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  apontamentos ApontamentoProducao[]
  paradas     ParadaProducao[]

  @@index([produtoId])
  @@index([situacao])
  @@map("ordens_producao")
}

// ==========================================
// SITUAÇÕES DAS MÁQUINAS
// ==========================================

enum SituacaoMaquina {
  ATIVA
  MANUTENCAO
  INATIVA
}

// ==========================================
// SITUAÇÕES DOS DISPOSITIVOS
// ==========================================

enum SituacaoTablet {
  PENDENTE
  AUTORIZADO
  BLOQUEADO
}

// ==========================================
// MÁQUINAS
// ==========================================

model Maquina {
  id        String          @id @default(uuid())
  codigo    String          @unique
  nome      String
  descricao String?
  situacao  SituacaoMaquina @default(ATIVA)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tablets      Tablet[]
  apontamentos ApontamentoProducao[]
  paradas      ParadaProducao[]

  @@map("maquinas")
}

// ==========================================
// TABLETS / CELULARES
// ==========================================

model Tablet {
  id            String         @id @default(uuid())
  identificador String         @unique
  nome          String?
  situacao      SituacaoTablet @default(PENDENTE)

  maquinaId String?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id], onDelete: Restrict)

  credencialHash String? @unique
  autorizadoEm   DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([maquinaId])
  @@map("tablets")
}

// ==========================================
// APONTAMENTOS DE PRODUÇÃO
// ==========================================

model ApontamentoProducao {
  id String @id @default(uuid())

  ordemProducaoId String
  ordemProducao   OrdemProducao @relation(fields: [ordemProducaoId], references: [id], onDelete: Restrict)

  maquinaId String
  maquina   Maquina @relation(fields: [maquinaId], references: [id], onDelete: Restrict)

  operadorId String
  operador   Usuario @relation(fields: [operadorId], references: [id], onDelete: Restrict)

  quantidadeProduzida Int
  quantidadeRejeitada Int @default(0)

  criadoEm DateTime @default(now())

  @@index([ordemProducaoId])
  @@index([maquinaId])
  @@index([operadorId])
  @@index([criadoEm])
  @@map("apontamentos_producao")
}

// ==========================================
// PARADAS DE PRODUÇÃO
// ==========================================

model ParadaProducao {
  id String @id @default(uuid())

  // Máquina relacionada
  maquinaId String
  maquina   Maquina @relation(fields: [maquinaId], references: [id], onDelete: Restrict)

  // OP associada (opcional)
  ordemProducaoId String?
  ordemProducao   OrdemProducao? @relation(fields: [ordemProducaoId], references: [id], onDelete: Restrict)

  // Motivo e observações
  motivo                  String
  observacoes             String?
  observacoesEncerramento String?

  // Início e encerramento
  iniciadoEm  DateTime  @default(now())
  encerradoEm DateTime?

  // Usuário responsável pela abertura
  iniciadoPorId String
  iniciadoPor   Usuario @relation("ParadaIniciadaPor", fields: [iniciadoPorId], references: [id], onDelete: Restrict)

  // Usuário responsável pelo encerramento
  encerradoPorId String?
  encerradoPor   Usuario? @relation("ParadaEncerradaPor", fields: [encerradoPorId], references: [id], onDelete: Restrict)

  @@index([maquinaId, encerradoEm])
  @@index([ordemProducaoId])
  @@index([iniciadoEm])
  @@map("paradas_producao")
}
