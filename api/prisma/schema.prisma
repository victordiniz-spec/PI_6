generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// PERFIS DE USUÁRIOS
// ==========================================

enum PerfilUsuario {
  ADMIN
  SUPERVISOR
  OPERADOR
}

// ==========================================
// USUÁRIOS
// ==========================================

model Usuario {
  id        String        @id @default(uuid())
  nome      String
  email     String        @unique
  senhaHash String
  perfil    PerfilUsuario @default(OPERADOR)
  ativo     Boolean       @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}

// ==========================================
// PRODUTOS
// ==========================================

model Produto {
  id          String  @id @default(uuid())
  codigo      String  @unique
  descricao   String
  cor         String?
  acabamento  String?
  larguraMm   Int?
  espessuraMm Int?
  unidade     String  @default("UN")
  ativo       Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Um produto pode participar de varias OPs
  ordensProducao OrdemProducao[]

  @@map("produtos")
}

// ==========================================
// SITUAÇÕES DAS ORDENS DE PRODUÇÃO
// ==========================================

enum SituacaoOP {
  PENDENTE
  EM_PRODUCAO
  PAUSADA
  FINALIZADA
  CANCELADA
}

// ==========================================
// ORDENS DE PRODUÇÃO
// ==========================================

model OrdemProducao {
  id     String @id @default(uuid())
  numero String @unique

  // Produto associado a OP
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  // Quantidades
  quantidadePlanejada Int
  quantidadeProduzida Int @default(0)

  // Situacao da producao
  situacao SituacaoOP @default(PENDENTE)

  // Informacoes adicionais
  observacoes  String?
  dataPrevisao DateTime?
  iniciadaEm   DateTime?
  finalizadaEm DateTime?

  // Auditoria basica
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Indices de consulta
  @@index([produtoId])
  @@index([situacao])
  @@map("ordens_producao")
}

// ==========================================
// SITUAÇÕES DAS MÁQUINAS
// ==========================================

enum SituacaoMaquina {
  ATIVA
  MANUTENCAO
  INATIVA
}

// ==========================================
// SITUAÇÕES DOS TABLETS / CELULARES
// ==========================================

enum SituacaoTablet {
  PENDENTE
  AUTORIZADO
  BLOQUEADO
}

// ==========================================
// MÁQUINAS DE PRODUÇÃO
// ==========================================

model Maquina {
  id        String          @id @default(uuid())
  codigo    String          @unique
  nome      String
  descricao String?
  situacao  SituacaoMaquina @default(ATIVA)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Dispositivos vinculados a maquina
  tablets Tablet[]

  @@map("maquinas")
}

// ==========================================
// TABLETS / CELULARES DE PRODUÇÃO
// ==========================================

model Tablet {
  id            String         @id @default(uuid())
  identificador String         @unique
  nome          String?
  situacao      SituacaoTablet @default(PENDENTE)

  // Maquina vinculada ao dispositivo
  maquinaId String?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id], onDelete: Restrict)

  // Hash da credencial de autenticacao
  // do dispositivo.
  // A credencial original nao deve ser
  // armazenada diretamente no banco.
  credencialHash String? @unique

  // Registro da autorizacao
  autorizadoEm DateTime?

  // Auditoria basica
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Indice para buscar tablets por maquina
  @@index([maquinaId])
  @@map("tablets")
}
